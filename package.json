{
  "name": "logpad",
  "version": "0.1.0",
  "private": true,
  "description": "Notepad++ 风格的跨平台日志查看器",
  "homepage": "https://github.com/andan-whl/logpad",
  "author": "andan-whl",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:linux": "electron-vite build && electron-builder --linux tar.gz --x64 && node scripts/build-deb.mjs && node scripts/verify-deb.mjs",
    "dist:linux:appimage": "electron-vite build && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  }
}
